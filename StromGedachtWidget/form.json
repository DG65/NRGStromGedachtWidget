{
    "elements": [
        {
            "type": "ExpansionPanel",
            "name": "DocPanel",
            "caption": "📖 Documentation & help",
            "expanded": false,
            "items": [
                {
                    "type": "Label",
                    "caption": "── How it works ──"
                },
                {
                    "type": "Label",
                    "caption": "This instance queries up to three independent data sources and provides its own traffic-light variable for each enabled source: StromGedacht (grid signal, requires a postal code, covers ONLY Baden-Württemberg and a few pilot areas), GrünstromIndex (eco signal, requires a postal code, nationwide) and Energy-Charts (eco signal, nationwide, no postal code needed). All enabled sources run in parallel; as long as at least one delivers, the instance stays active. Outside the StromGedacht area simply enable only GrünstromIndex and/or Energy-Charts."
                },
                {
                    "type": "Label",
                    "caption": "── Display ──"
                },
                {
                    "type": "Label",
                    "caption": "The variable 'Display' contains a ready-made HTML traffic-light widget that can be placed in a WebFront manually. For a graphically configurable, native tile there is also the separate module 'StromGedachtTile' – simply create a new instance of it and choose this instance as the source (with only one StromGedachtWidget instance this happens automatically)."
                },
                {
                    "type": "Label",
                    "caption": "── Automations ──"
                },
                {
                    "type": "Label",
                    "caption": "In the 'Automations (If → Then)' section below you can create rules based on the traffic-light/signal values of this instance that switch any switchable variable in the system – e.g. 'If StromGedacht traffic light = Red, then switch off wallbox'. Rules are edge-triggered (they fire when the condition becomes true, not again on every data update). The 'StromGedachtTile' tile can show, create, edit and enable/disable the same rules."
                },
                {
                    "type": "Label",
                    "caption": "── More help ──"
                },
                {
                    "type": "Label",
                    "caption": "Detailed documentation: github.com/DG65/NRGStromGedachtWidget."
                },
                {
                    "type": "Label",
                    "caption": "The '🔄 Force apply' button calls IPS_ApplyChanges() directly, without you having to change anything in the form first – handy after a module update if the instance does not pick up the new code on its own."
                }
            ]
        },
        {
            "type": "CheckBox",
            "name": "EnableStromGedacht",
            "caption": "StromGedacht (TransnetBW, grid signal, postal code required, ONLY Baden-Württemberg + pilot areas)"
        },
        {
            "type": "CheckBox",
            "name": "EnableGSI",
            "caption": "GrünstromIndex (Corrently, eco signal, postal code required)"
        },
        {
            "type": "CheckBox",
            "name": "EnableEnergyCharts",
            "caption": "Energy-Charts traffic light (Fraunhofer ISE, eco signal, all of Germany)"
        },
        {
            "type": "ValidationTextBox",
            "name": "ZipCode",
            "caption": "Postal code (for StromGedacht and GrünstromIndex)"
        },
        {
            "type": "NumberSpinner",
            "name": "UpdateInterval",
            "caption": "Update interval",
            "suffix": " seconds",
            "minimum": 60
        },
        {
            "type": "ExpansionPanel",
            "caption": "Automations (If → Then)",
            "items": [
                {
                    "type": "Label",
                    "caption": "Rules based on the traffic-light/signal values of this instance: as soon as the condition is met, the module switches the target variable. Edge-triggered – a rule fires when the condition becomes true, not again on every data update. 'If data point' automatically lists only the values of the sources enabled above – a disabled source (e.g. GrünstromIndex without a checkmark) does not appear there. The 'StromGedachtTile' tile can show, manage and enable/disable rules."
                },
                {
                    "type": "List",
                    "name": "DataActions",
                    "caption": "Rules",
                    "rowCount": 6,
                    "add": true,
                    "delete": true,
                    "columns": [
                        {
                            "caption": "Active",
                            "name": "Active",
                            "width": "70px",
                            "add": true,
                            "edit": {
                                "type": "CheckBox"
                            }
                        },
                        {
                            "caption": "If data point",
                            "name": "Source",
                            "width": "220px",
                            "add": "",
                            "edit": {
                                "type": "Select",
                                "options": []
                            }
                        },
                        {
                            "caption": "Condition",
                            "name": "Op",
                            "width": "140px",
                            "add": "true",
                            "edit": {
                                "type": "Select",
                                "options": [
                                    {
                                        "caption": "turns ON (true)",
                                        "value": "true"
                                    },
                                    {
                                        "caption": "turns OFF (false)",
                                        "value": "false"
                                    },
                                    {
                                        "caption": "= (equal)",
                                        "value": "eq"
                                    },
                                    {
                                        "caption": "≠ (not equal)",
                                        "value": "ne"
                                    },
                                    {
                                        "caption": "> (greater)",
                                        "value": "gt"
                                    },
                                    {
                                        "caption": "≥ (greater or equal)",
                                        "value": "ge"
                                    },
                                    {
                                        "caption": "< (less)",
                                        "value": "lt"
                                    },
                                    {
                                        "caption": "≤ (less or equal)",
                                        "value": "le"
                                    },
                                    {
                                        "caption": "changes",
                                        "value": "change"
                                    }
                                ]
                            }
                        },
                        {
                            "caption": "Compare value",
                            "name": "Compare",
                            "width": "115px",
                            "add": "",
                            "edit": {
                                "type": "ValidationTextBox"
                            }
                        },
                        {
                            "caption": "Then target variable",
                            "name": "Target",
                            "width": "auto",
                            "add": 0,
                            "edit": {
                                "type": "SelectVariable"
                            }
                        },
                        {
                            "caption": "Action",
                            "name": "Action",
                            "width": "140px",
                            "add": "on",
                            "edit": {
                                "type": "Select",
                                "options": [
                                    {
                                        "caption": "Switch on",
                                        "value": "on"
                                    },
                                    {
                                        "caption": "Switch off",
                                        "value": "off"
                                    },
                                    {
                                        "caption": "Toggle",
                                        "value": "toggle"
                                    },
                                    {
                                        "caption": "Set value",
                                        "value": "value"
                                    }
                                ]
                            }
                        },
                        {
                            "caption": "Value",
                            "name": "Value",
                            "width": "100px",
                            "add": "",
                            "edit": {
                                "type": "ValidationTextBox"
                            }
                        }
                    ]
                },
                {
                    "type": "Label",
                    "caption": "'Compare value' is only needed for =, ≠, >, ≥, <, ≤; 'Value' only for the action 'Set value'. Numbers with period or comma. The target variable is switched via its action (like a click in the visualization); variables without an action are written directly."
                },
                {
                    "type": "Label",
                    "caption": "Reference values (the tile offers these as a dropdown, here only free text is possible):"
                },
                {
                    "type": "Label",
                    "caption": "StromGedacht traffic light: -1 Super green · 1 Green · 2 Yellow · 3 Orange · 4 Red"
                },
                {
                    "type": "Label",
                    "caption": "Energy-Charts signal: -1 Red (grid bottleneck) · 0 Red · 1 Yellow · 2 Green"
                },
                {
                    "type": "Label",
                    "caption": "GrünstromIndex / Energy-Charts renewable share: 0–100 (percent, no fixed steps)"
                }
            ]
        }
    ],
    "actions": [
        {
            "type": "Button",
            "caption": "Update now",
            "onClick": "echo SGW_Update($id);"
        },
        {
            "type": "Button",
            "caption": "🔄 Force apply (without changing the form)",
            "onClick": "IPS_ApplyChanges($id); echo '✅ ApplyChanges()';"
        }
    ],
    "status": [
        {
            "code": 104,
            "icon": "inactive",
            "caption": "Please complete the configuration (enable at least one data source, enter a postal code if needed)"
        },
        {
            "code": 201,
            "icon": "error",
            "caption": "No data for this postal code from any enabled source"
        },
        {
            "code": 202,
            "icon": "error",
            "caption": "No enabled source reachable – see debug"
        }
    ]
}
