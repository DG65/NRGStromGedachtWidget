                    "caption": "Background"
                },
                {
                    "type": "SelectColor",
                    "name": "ColorBox",
                    "caption": "Tiles/boxes"
                },
                {
                    "type": "SelectColor",
                    "name": "ColorText",
                    "caption": "Text (values)"
                },
                {
                    "type": "SelectColor",
