                    "caption": "Orange"
                },
                {
                    "type": "SelectColor",
                    "name": "ColorRed",
                    "caption": "Red"
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "name": "PanelSurface",
            "caption": "🖌️ Surfaces & text",
            "items": [
